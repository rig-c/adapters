{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "strict": true,
    "noUncheckedIndexedAccess": false,
    "noEmit": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "paths": {
      "@rig-c/pixi": [
        "./packages/pixi/src/index.ts"
      ],
      "@rig-c/pixi/pixi": [
        "./packages/pixi/src/index.ts"
      ]
    }
  },
  "include": [
    "src",
    "packages",
    "playwright.config.ts",
    "vite.config.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "packages/*/dist"
  ]
}
