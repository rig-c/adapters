{
  "name": "@rig-c/adapters",
  "version": "0.1.0",
  "private": true,
  "description": "Adapters for rig-c: play a rig-c model inside a web engine or renderer through @rig-c/play's core.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/rig-c/adapters.git"
  },
  "exports": {
    ".": "./src/index.ts",
    "./pixi": "./src/pixi.ts"
  },
  "scripts": {
    "fetch-assets": "bash scripts/fetch-assets.sh",
    "predev": "bash scripts/fetch-assets.sh",
    "dev": "vite",
    "prebuild": "bash scripts/fetch-assets.sh",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "bunx tsc --noEmit",
    "lint": "bunx eslint .",
    "test": "playwright test"
  },
  "dependencies": {
    "@rig-c/play": "1.10.0",
    "pixi.js": "8.22.0"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@types/node": "^22",
    "eslint": "^10.9.0",
    "rig-c": "2.52.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^6.0.0"
  }
}
