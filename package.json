{
  "name": "@rig-c/adapters",
  "version": "0.1.0",
  "private": true,
  "description": "Adapters for rig-c: play a rig-c model inside a web engine or renderer through @rig-c/play's core.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/rig-c/adapters.git"
  },
  "scripts": {
    "fetch-assets": "bash scripts/fetch-assets.sh",
    "predev": "bash scripts/fetch-assets.sh",
    "dev": "vite",
    "example:look": "vite --open /examples/look/index.html",
    "prebuild": "bash scripts/fetch-assets.sh && bun scripts/prepare-oracle.mjs",
    "build": "bun run build:libraries && tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "bun scripts/prepare-oracle.mjs && bunx tsc --noEmit",
    "lint": "bunx eslint .",
    "test": "playwright test",
    "build:libraries": "bun scripts/build-packages.mjs",
    "check:packages": "bun scripts/check-packages.mjs",
    "check:release": "bun scripts/check-release.mjs",
    "smoke": "bun scripts/install-smoke.mjs",
    "bench": "bun scripts/bench.mjs",
    "verify": "bun run build:libraries && bun run typecheck && bun run lint && bun run check:packages && bun run check:release && bun run smoke && bun run test"
  },
  "dependencies": {
    "@rig-c/play": "1.12.0",
    "pixi.js": "8.22.0",
    "@rig-c/pixi": "workspace:*",
    "phaser": "4.2.1",
    "@rig-c/phaser": "workspace:*",
    "three": "0.186.1",
    "@rig-c/three": "workspace:*"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@types/node": "^22",
    "eslint": "^10.9.0",
    "rig-c": "2.64.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^6.0.0",
    "tsup": "^8.5.0",
    "release-please": "^17.1.3",
    "yaml": "^2.8.1",
    "@types/three": "0.186.0"
  },
  "workspaces": [
    "packages/*"
  ]
}
